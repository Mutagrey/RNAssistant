  "schemaVersion": 1,
  "scope": "RNAssistant static WebView UI and authored HTML workspace vendor source carriers",
  "sourceUrlsAreProvenanceOnly": true,
  "policy": {
    "runtimeNetwork": "deny",
    "telemetry": "deny",
    "autoUpdate": "deny",
    "dynamicImport": "deny",
    "csp": {
      "connectSrc": [
        "https://rnassistant.local-resource/v1/"
      ],
      "fontSrc": [
        "'self'"
      ],
      "workerSrc": [
        "'none'"
      ]
    },
    "workers": {
      "mode": "deny-until-manifested-host-factory",
      "allowed": [],
      "requiredLifecycle": [
        "create-by-manifest-id",
        "cancel",
        "terminate"
      ]
    },
    "wasm": {
      "mode": "deny",
      "allowed": []
    },
    "fonts": {
      "mode": "manifest-only",
      "formats": [
        "woff2"
      ],
      "allowedCount": 20
    }
  },

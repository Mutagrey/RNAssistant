{
  "version": 2,
  "kind": "extraction",
  "template": {
    "language": 2,
    "id": "orientation-example",
    "revision": 1,
    "context": {},
    "bindings": {
      "parameter": {
        "expr": "lookup(\"parameters\", text(field(\"code\")), \"production-form\")"
      },
      "unit": {
        "expr": "lookup(\"units\", text(field(\"unit\")), \"production-form\")"
      },
      "period": {
        "expr": "period.month(parse.year(text(field(\"year\"))), parse.monthRu(text(field(\"month\"))))"
      },
      "value": {
        "expr": "round(decimal(raw(field(\"amount\")), \"en-US\"), 2, \"half-even\")"
      },
      "role": {
        "expr": "\"observation\""
      },
      "dimensions": {
        "entity": {
          "expr": "text(field(\"entity\"))"
        }
      }
    },
    "output": "observations",

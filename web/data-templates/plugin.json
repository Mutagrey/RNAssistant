  "id": "data-templates",
  "name": "Данные и шаблоны",
  "version": "1.0.0",
  "hostProtocol": 1,
  "icon": "chart",
  "capabilities": [
    "project.read",
    "project.write"
  ],
  "commands": [
    {
      "id": "inspect-template",
      "description": "Inspect a Data Templates template using the published compiler.",
      "entry": "commands.js",
      "argumentsSchema": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "description": "input"
          }
        },
        "required": [
          "input"
        ],
        "additionalProperties": false
      },
      "resultSchema": {
        "type": "object",
        "properties": {
          "inspection": {
            "type": "object",
            "description": "Compiler inspection"
          }
        },
        "required": [
          "inspection"
        ],
        "additionalProperties": false
      },
      "writesData": false
    },
    {
      "id": "inspect-dictionary",
      "description": "Inspect Data Templates dictionaries.",
      "entry": "commands.js",
      "argumentsSchema": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "description": "input"
          }
        },
        "required": [
          "input"
        ],
        "additionalProperties": false
      },
      "resultSchema": {
        "type": "object",
        "properties": {
          "inspection": {
            "type": "object",
            "description": "Compiler inspection"
          }
        },
        "required": [
          "inspection"
        ],
        "additionalProperties": false
      },
      "writesData": false
    },
    {
      "id": "extract",
      "description": "Extract a selected project XLSX to an isolated result snapshot. Does not publish into a user data project.",
      "entry": "commands.js",
      "argumentsSchema": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "description": "input"
          },
          "sourcePath": {
            "type": "string",
            "description": "sourcePath"
          },
          "templateName": {
            "type": "string",
            "description": "templateName"
          },
          "maximumBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 268435456,
            "description": "maximumBytes"
          }
        },
        "required": [
          "input",
          "sourcePath",
          "templateName",
          "maximumBytes"
        ],
        "additionalProperties": false
      },
      "resultSchema": {
        "type": "object",
        "properties": {
          "bytes": {
            "type": "integer",
            "description": "Exact output byte length"
          },
          "summary": {
            "type": "object",
            "description": "Engine summary"
          },
          "preview": {
            "type": "array",
            "description": "Bounded preview",
            "items": {
              "type": "object"
            }
          },
          "name": {
            "type": "string",
            "description": "Relative name of the temporary canonical result"
          }
        },
        "required": [
          "name",
          "bytes",
          "summary",
          "preview"
        ],
        "additionalProperties": false
      },
      "writesData": false
    },
    {
      "id": "extract-to-file",
      "description": "Extract a selected project XLSX into a canonical JSON file in that same data project, with guarded publication and exact read-back.",
      "entry": "commands.js",
      "argumentsSchema": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "description": "input"
          },
          "sourcePath": {
            "type": "string",
            "description": "sourcePath"
          },
          "templateName": {
            "type": "string",
            "description": "templateName"
          },
          "maximumBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 268435456,
            "description": "maximumBytes"
          },
          "outputPath": {
            "type": "string",
            "description": "Relative output JSON path in the selected data project"
          }
        },
        "required": [
          "input",
          "sourcePath",
          "templateName",
          "maximumBytes",
          "outputPath"
        ],
        "additionalProperties": false
      },
      "resultSchema": {
        "type": "object",
        "properties": {
          "bytes": {
            "type": "integer",
            "description": "Exact output byte length"
          },
          "summary": {
            "type": "object",
            "description": "Engine summary"
          },
          "preview": {
            "type": "array",
            "description": "Bounded preview",
            "items": {
              "type": "object"
            }
          },
          "path": {
            "type": "string",
            "description": "Relative output JSON path in the selected data project"
          }
        },
        "required": [
          "path",
          "bytes",
          "summary",
          "preview"
        ],
        "additionalProperties": false
      },
      "writesData": true
    }
  ],

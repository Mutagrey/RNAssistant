{
  "version": 1,
  "kind": "matrix-xlsx-extraction",
  "template": {
    "language": 1,
    "kind": "matrix",
    "id": "production-form",
    "revision": 1,
    "sheet": "Данные",
    "bounds": "A1:AG20",
    "context": {
      "yearA": {
        "expr": "parse.year(text(cell(\"P\", 5)))"
      },
      "yearB": {
        "expr": "parse.year(text(cell(\"AD\", 5)))"
      }
    },
    "rows": {
      "select": "A12:A13",
      "parameter": {
        "expr": "lookup(\"parameters\", text(cell(\"A\", row)), \"production-form\")"
      },
      "unit": {
        "expr": "lookup(\"units\", text(cell(\"B\", row)), \"production-form\")"
      }
    },
    "columns": [
      {
        "id": "months-a",
        "select": "C:D | J:K",
        "period": {
          "expr": "period.month(ctx.yearA, parse.monthRu(text(cell(col, 5))))"
        },
        "role": "observation"
      },
      {
        "id": "annual-a",
        "select": "P",
        "period": {
          "expr": "period.year(ctx.yearA)"
        },
        "role": "reported_total"
      },
      {
        "id": "months-b",
        "select": "R",
        "period": {
          "expr": "period.month(ctx.yearB, parse.monthRu(text(cell(col, 5))))"
        },
        "role": "observation"
      },
      {
        "id": "annual-b",
        "select": "AD",
        "period": {
          "expr": "period.year(ctx.yearB)"
        },
        "role": "reported_total"
      },
      {
        "id": "later-year",
        "select": "AF",
        "period": {
          "expr": "period.year(parse.year(text(cell(col, 5))))"
        },
        "role": "observation"
      }
    ],
    "value": {
      "expr": "decimal(raw(cell(col, row)), \"ru-RU\")"
    }
  },
  "dictionaries": {
    "version": 1,
    "revision": 1,
    "units": [
      {
        "id": "t",
        "name": "Тонны"
      }
    ],
    "parameters": [
      {
        "id": "production.volume",
        "name": "Объём производства",
        "valueType": "decimal",
        "unitId": "t",
        "dimensions": [
          "entity",
          "variant"
        ],
        "temporalMeaning": "flow"
      },
      {
        "id": "production.loss",
        "name": "Потери",
        "valueType": "decimal",
        "unitId": "t",
        "dimensions": [
          "entity",
          "variant"
        ],
        "temporalMeaning": "flow"
      }
    ],
    "parameterMappings": [
      {
        "scope": "production-form",
        "source": "0012",
        "targetId": "production.volume"
      },
      {
        "scope": "production-form",
        "source": "0099",
        "targetId": "production.loss"
      }
    ],
    "unitMappings": [
      {
        "scope": "production-form",
        "source": "т",
        "targetId": "t"
      }
    ]
  },
  "dataset": {
    "id": "production-example",
    "dimensions": {
      "entity": "plant-1",
      "variant": "actual"
    }
  },
  "source": {
    "formulaPolicy": "stored-cache"
  }
}

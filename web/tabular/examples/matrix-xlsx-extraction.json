{
  "version": 2,
  "kind": "xlsx-extraction",
  "template": {
    "language": 2,
    "id": "production-form",
    "revision": 2,
    "source": {
      "kind": "matrix",
      "sheet": "Данные",
      "bounds": "A1:AG20",
      "rows": [
        {
          "id": "parameters",
          "select": "A12:A13",
          "bindings": {
            "parameter": {
              "expr": "lookup(\"parameters\", text(cell(\"A\", row)), \"production-form\")"
            },
            "unit": {
              "expr": "lookup(\"units\", text(cell(\"B\", row)), \"production-form\")"
            }
          }
        }
      ],
      "columns": [
        {
          "id": "months-a",
          "select": "C:D | J:K",
          "bindings": {
            "period": {
              "expr": "period.month(ctx.yearA, parse.monthRu(text(cell(col, 5))))"
            },
            "role": {
              "expr": "\"observation\""
            }
          }
        },
        {
          "id": "annual-a",
          "select": "P",
          "bindings": {
            "period": {
              "expr": "period.year(ctx.yearA)"
            },
            "role": {
              "expr": "\"reported_total\""
            }
          }
        },
        {
          "id": "months-b",
          "select": "R",
          "bindings": {
            "period": {
              "expr": "period.month(ctx.yearB, parse.monthRu(text(cell(col, 5))))"
            },
            "role": {
              "expr": "\"observation\""
            }
          }
        },
        {
          "id": "annual-b",
          "select": "AD",
          "bindings": {
            "period": {
              "expr": "period.year(ctx.yearB)"
            },
            "role": {
              "expr": "\"reported_total\""
            }
          }
        },
        {
          "id": "later-year",
          "select": "AF",
          "bindings": {
            "period": {
              "expr": "period.year(parse.year(text(cell(col, 5))))"
            },
            "role": {
              "expr": "\"observation\""
            }
          }
        }
      ]
    },
    "context": {
      "yearA": {
        "expr": "parse.year(text(cell(\"P\", 5)))"
      },
      "yearB": {
        "expr": "parse.year(text(cell(\"AD\", 5)))"
      }
    },
    "bindings": {
      "value": {
        "expr": "decimal(raw(cell(col, row)), \"ru-RU\")"
      }
    },
    "output": "observations",
    "policies": {
      "missing": "preserve",
      "mapping": "error",
      "duplicates": "error",
      "conflicts": "error"
    }
  },
  "dictionaries": {
    "version": 1,
    "revision": 1,
    "units": [
      {
        "id": "t",
        "name": "Тонны"
      }
    ],
    "parameters": [
      {
        "id": "production.volume",
        "name": "Объём производства",
        "valueType": "decimal",
        "unitId": "t",
        "dimensions": [
          "entity",
          "variant"
        ],
        "temporalMeaning": "flow"
      },
      {
        "id": "production.loss",
        "name": "Потери",
        "valueType": "decimal",
        "unitId": "t",
        "dimensions": [
          "entity",
          "variant"
        ],
        "temporalMeaning": "flow"
      }
    ],
    "parameterMappings": [
      {
        "scope": "production-form",
        "source": "0012",
        "targetId": "production.volume"
      },
      {
        "scope": "production-form",
        "source": "0099",
        "targetId": "production.loss"
      }
    ],
    "unitMappings": [
      {
        "scope": "production-form",
        "source": "т",
        "targetId": "t"
      }
    ]
  },
  "dataset": {
    "id": "production-example",
    "dimensions": {
      "entity": "plant-1",
      "variant": "actual"
    }
  },
  "source": {
    "formulaPolicy": "stored-cache"
  }
}

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <UseSystemDrawing>true</UseSystemDrawing>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\..\packages\Newtonsoft.Json.13.0.3\lib\net6.0\Newtonsoft.Json.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="PDFtoImage">
      <HintPath>..\..\vendor\pdf-rendering\managed\net8.0\PDFtoImage.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SkiaSharp">
      <HintPath>..\..\vendor\pdf-rendering\managed\net8.0\SkiaSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UglyToad.PdfPig">
      <HintPath>..\..\packages\PdfPig.0.1.15\lib\net8.0\UglyToad.PdfPig.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UglyToad.PdfPig.Core">
      <HintPath>..\..\packages\PdfPig.0.1.15\lib\net8.0\UglyToad.PdfPig.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UglyToad.PdfPig.DocumentLayoutAnalysis">
      <HintPath>..\..\packages\PdfPig.0.1.15\lib\net8.0\UglyToad.PdfPig.DocumentLayoutAnalysis.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UglyToad.PdfPig.Fonts">
      <HintPath>..\..\packages\PdfPig.0.1.15\lib\net8.0\UglyToad.PdfPig.Fonts.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UglyToad.PdfPig.Tokenization">
      <HintPath>..\..\packages\PdfPig.0.1.15\lib\net8.0\UglyToad.PdfPig.Tokenization.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UglyToad.PdfPig.Tokens">
      <HintPath>..\..\packages\PdfPig.0.1.15\lib\net8.0\UglyToad.PdfPig.Tokens.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\src\RNAssistant.Core\Models\*.cs" Link="Core\Models\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\RNAssistant.Core\Llm\*.cs" Link="Core\Llm\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\RNAssistant.Core\ModelProtocol\*.cs" Link="Core\ModelProtocol\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\RNAssistant.Core\Agent\*.cs" Link="Core\Agent\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\RNAssistant.Core\Persistence\*.cs" Link="Core\Persistence\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\RNAssistant.Core\Tools\*.cs" Link="Core\Tools\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\RNAssistant.Core\Services\*.cs" Link="Core\Services\%(Filename)%(Extension)" />
    <Compile
      Include="..\..\src\RNAssistant.Core\Storage\*.cs"
      Exclude="..\..\src\RNAssistant.Core\Storage\ProtectedSecretStore.cs;..\..\src\RNAssistant.Core\Storage\SettingsService.cs"
      Link="Core\Storage\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\RNAssistant.Office\Contracts\*.cs" Link="Office\Contracts\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\RNAssistant.Office\Agent\*.cs" Link="Office\Agent\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\RNAssistant.Office\Controller\*.cs" Link="Office\Controller\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\RNAssistant.Office\Diagnostics\*.cs" Link="Office\Diagnostics\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\RNAssistant.Office\Runtime\OfficeDocumentExecutionGuard.cs" Link="Office\Runtime\OfficeDocumentExecutionGuard.cs" />
    <Compile
      Include="..\..\src\RNAssistant.Office\Services\*.cs"
      Exclude="..\..\src\RNAssistant.Office\Services\AttachmentImageService.cs"
      Link="Office\Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\RNAssistant.Office\Tools\*.cs" Link="Office\Tools\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\RNAssistant.Office\WebView\AssistantWebBridge.cs" Link="Office\WebView\AssistantWebBridge.cs" />
    <Compile Include="..\..\src\RNAssistant.Office\WebView\BridgeRequestCancellationRegistry.cs" Link="Office\WebView\BridgeRequestCancellationRegistry.cs" />
    <Compile Include="..\..\tests\RNAssistant.Testing\FakeOfficeAdapter.cs" Link="Testing\FakeOfficeAdapter.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\vendor\pdf-rendering\runtimes\win-x64\native\pdfium.dll"
          Link="pdfium.dll"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\vendor\pdf-rendering\runtimes\win-x64\native\libSkiaSharp.dll"
          Link="libSkiaSharp.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

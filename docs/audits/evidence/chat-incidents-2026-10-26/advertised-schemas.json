  {
    "Id": "common.resources_search",
    "Description": "Read-only literal or line-oriented .NET regex search. Select one target or a scope. Results contain bounded snippets and 1-based UTF-16 line/column coordinates; no language parser is required. Workspace scope searches only the selected directory (root when omitted), unless recursive=true includes descendants. Only scanComplete and sourceComplete together establish absence within the selected target, depth and filters. Continue with the returned semantic continuation and identical arguments; changed sources or lost continuation state require a fresh search. Search is not a complete source read or patch authorization.",
    "Schema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "target": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "mode": {
              "type": "string",
              "enum": [
                "literal",
                "regex"
              ],
              "default": "literal"
            },
            "matchCase": {
              "type": "boolean"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "continuation": {
              "type": "object",
              "properties": {
                "afterTarget": {
                  "type": "string",
                  "minLength": 1
                },
                "afterLine": {
                  "type": "integer",
                  "minimum": 0
                },
                "afterColumn": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "afterTarget",
                "afterLine",
                "afterColumn"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "target",
            "query"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "enum": [
                "workspace"
              ]
            },
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "mode": {
              "type": "string",
              "enum": [
                "literal",
                "regex"
              ],
              "default": "literal"
            },
            "matchCase": {
              "type": "boolean"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "continuation": {
              "type": "object",
              "properties": {
                "afterTarget": {
                  "type": "string",
                  "minLength": 1
                },
                "afterLine": {
                  "type": "integer",
                  "minimum": 0
                },
                "afterColumn": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "afterTarget",
                "afterLine",
                "afterColumn"
              ],
              "additionalProperties": false
            },
            "directory": {
              "type": "string",
              "maxLength": 1000
            },
            "recursive": {
              "type": "boolean",
              "default": false
            },
            "includeGlobs": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "description": "Workspace-relative glob: *, ?, ** and **/. No negation or character classes."
            },
            "excludeGlobs": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "description": "Workspace-relative glob: *, ?, ** and **/. No negation or character classes."
            }
          },
          "required": [
            "scope",
            "query"
          ],
          "additionalProperties": false
        }
      ]
    }

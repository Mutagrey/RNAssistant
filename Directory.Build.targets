<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildThisFileDirectory)build/RNAssistant.GitArchive.props" Condition="Exists('$(MSBuildThisFileDirectory)build/RNAssistant.GitArchive.props')" />
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.local.props" Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.local.props')" />

  <PropertyGroup>
    <_RNAssistantRepositoryRoot>$(MSBuildThisFileDirectory)</_RNAssistantRepositoryRoot>
    <_RNAssistantExpectedVersion Condition="'$(RNAssistantVersionSuffix)' == ''">$(RNAssistantVersionPrefix)</_RNAssistantExpectedVersion>
    <_RNAssistantExpectedVersion Condition="'$(RNAssistantVersionSuffix)' != ''">$(RNAssistantVersionPrefix)-$(RNAssistantVersionSuffix)</_RNAssistantExpectedVersion>
    <_RNAssistantVersionPrefixValid>$([System.Text.RegularExpressions.Regex]::IsMatch('$(RNAssistantVersionPrefix)', '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'))</_RNAssistantVersionPrefixValid>
    <_RNAssistantVersionSuffixValid Condition="'$(RNAssistantVersionSuffix)' != ''">$([System.Text.RegularExpressions.Regex]::IsMatch('$(RNAssistantVersionSuffix)', '^((0|[1-9][0-9]*)|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(\.((0|[1-9][0-9]*)|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*$'))</_RNAssistantVersionSuffixValid>
    <_RNAssistantArchiveCommitValid>$([System.Text.RegularExpressions.Regex]::IsMatch('$(RNAssistantArchiveCommitSha)', '^([0-9a-f]{40}|[0-9a-f]{64})$'))</_RNAssistantArchiveCommitValid>
  </PropertyGroup>

  <Target Name="ResolveRNAssistantBuildIdentity" BeforeTargets="GetAssemblyAttributes">
    <PropertyGroup Condition="!Exists('$(_RNAssistantRepositoryRoot).git')">
      <RNAssistantCommitSha Condition="'$(RNAssistantCommitSha)' == '' and '$(_RNAssistantArchiveCommitValid)' == 'True'">$(RNAssistantArchiveCommitSha)</RNAssistantCommitSha>
      <RNAssistantCommitSha Condition="'$(RNAssistantCommitSha)' == ''">unknown</RNAssistantCommitSha>
      <RNAssistantBranch Condition="'$(RNAssistantBranch)' == ''">unknown</RNAssistantBranch>
      <RNAssistantWorkingTreeState Condition="'$(RNAssistantWorkingTreeState)' == ''">unknown</RNAssistantWorkingTreeState>
    </PropertyGroup>
    <Warning Condition="!Exists('$(_RNAssistantRepositoryRoot).git') and '$(RNAssistantCommitSha)' == 'unknown'"
             Text="Source archive build: Git provenance is unknown. For exact build identity, supply RNAssistantCommitSha, RNAssistantBranch and RNAssistantWorkingTreeState in Directory.Build.local.props. This build is not release evidence." />
    <Warning Condition="!Exists('$(_RNAssistantRepositoryRoot).git') and '$(RNAssistantCommitSha)' != 'unknown' and ('$(RNAssistantBranch)' == 'unknown' or '$(RNAssistantWorkingTreeState)' == 'unknown')"
             Text="Source archive build: commit $(RNAssistantCommitSha) is identified, but branch or working-tree state is unknown. This build is not release evidence." />
    <Exec Command="git rev-parse --verify HEAD" WorkingDirectory="$(_RNAssistantRepositoryRoot)"
          Condition="Exists('$(_RNAssistantRepositoryRoot).git') and '$(RNAssistantCommitSha)' == ''" ConsoleToMSBuild="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="RNAssistantCommitSha" />
    </Exec>
    <Exec Command="git rev-parse --abbrev-ref HEAD" WorkingDirectory="$(_RNAssistantRepositoryRoot)"
          Condition="Exists('$(_RNAssistantRepositoryRoot).git') and '$(RNAssistantBranch)' == ''" ConsoleToMSBuild="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="RNAssistantBranch" />
    </Exec>
    <Exec Command="git status --porcelain=v1 --untracked-files=all" WorkingDirectory="$(_RNAssistantRepositoryRoot)"
          Condition="Exists('$(_RNAssistantRepositoryRoot).git') and '$(RNAssistantWorkingTreeState)' == ''" ConsoleToMSBuild="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" ItemName="_RNAssistantBuildChanges" />
    </Exec>
    <Error Condition="(Exists('$(_RNAssistantRepositoryRoot).git') or '$(RNAssistantCommitSha)' != 'unknown') and !$([System.Text.RegularExpressions.Regex]::IsMatch('$(RNAssistantCommitSha)', '^([0-9a-f]{40}|[0-9a-f]{64})$'))"
           Text="RNAssistantCommitSha must be a full Git commit SHA." />
    <PropertyGroup>
      <RNAssistantWorkingTreeState Condition="'$(RNAssistantWorkingTreeState)' == '' and '@(_RNAssistantBuildChanges)' != ''">dirty</RNAssistantWorkingTreeState>
      <RNAssistantWorkingTreeState Condition="'$(RNAssistantWorkingTreeState)' == ''">clean</RNAssistantWorkingTreeState>
      <RNAssistantBuildUtc Condition="'$(RNAssistantBuildUtc)' == ''">$([System.DateTime]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ssZ'))</RNAssistantBuildUtc>
      <RNAssistantChannel Condition="'$(RNAssistantVersionSuffix)' == ''">stable</RNAssistantChannel>
      <RNAssistantChannel Condition="'$(RNAssistantVersionSuffix)' != ''">$([System.Text.RegularExpressions.Regex]::Replace('$(RNAssistantVersionSuffix)', '\..*$', ''))</RNAssistantChannel>
      <RNAssistantRuntimePlatform Condition="'$(RNAssistantRuntimePlatform)' == ''">$(Platform)</RNAssistantRuntimePlatform>
      <RNAssistantRuntimePlatform Condition="'$(RNAssistantRuntimePlatform)' == ''">unknown</RNAssistantRuntimePlatform>
      <_RNAssistantExpectedInformationalVersion>$(Version)+source-archive</_RNAssistantExpectedInformationalVersion>
      <_RNAssistantExpectedInformationalVersion Condition="'$(RNAssistantCommitSha)' != 'unknown'">$(Version)+g$(RNAssistantCommitSha.Substring(0, 12))</_RNAssistantExpectedInformationalVersion>
      <_RNAssistantExpectedInformationalVersion Condition="'$(RNAssistantWorkingTreeState)' == 'dirty'">$(_RNAssistantExpectedInformationalVersion).dirty</_RNAssistantExpectedInformationalVersion>
      <_RNAssistantExpectedInformationalVersion Condition="'$(RNAssistantWorkingTreeState)' == 'unknown'">$(_RNAssistantExpectedInformationalVersion).unknown</_RNAssistantExpectedInformationalVersion>
      <InformationalVersion Condition="'$(InformationalVersion)' == '$(Version)'">$(_RNAssistantExpectedInformationalVersion)</InformationalVersion>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyMetadata Include="ProductVersion" Value="$(Version)" />
      <AssemblyMetadata Include="CommitSha" Value="$(RNAssistantCommitSha)" />
      <AssemblyMetadata Include="BuildUtc" Value="$(RNAssistantBuildUtc)" />
      <AssemblyMetadata Include="Branch" Value="$(RNAssistantBranch)" />
      <AssemblyMetadata Include="Channel" Value="$(RNAssistantChannel)" />
      <AssemblyMetadata Include="WorkingTreeState" Value="$(RNAssistantWorkingTreeState)" />
      <AssemblyMetadata Include="Configuration" Value="$(Configuration)" />
      <AssemblyMetadata Include="RuntimePlatform" Value="$(RNAssistantRuntimePlatform)" />
      <AssemblyMetadata Include="BuildEvidenceSignerSha256" Value="$(RNAssistantBuildEvidenceSignerSha256)" />
    </ItemGroup>
  </Target>

  <Target Name="ValidateVersionFormat" BeforeTargets="PrepareForBuild" DependsOnTargets="ResolveRNAssistantBuildIdentity">
    <Error Condition="'$(_RNAssistantVersionPrefixValid)' != 'True'" Text="RNAssistantVersionPrefix must be a SemVer core such as 2.0.0." />
    <Error Condition="'$(RNAssistantVersionSuffix)' != '' and '$(_RNAssistantVersionSuffixValid)' != 'True'" Text="RNAssistantVersionSuffix must contain dot-separated SemVer prerelease identifiers, for example beta.1." />
    <Error Condition="'$(Version)' != '$(_RNAssistantExpectedVersion)'" Text="Version must be derived from RNAssistantVersionPrefix and RNAssistantVersionSuffix." />
    <Error Condition="'$(AssemblyVersion)' != '$(RNAssistantAssemblyVersion)'" Text="AssemblyVersion must match RNAssistantAssemblyVersion, independently of the product version." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(RNAssistantBuildNumber)', '^(0|[1-9][0-9]{0,4})$'))" Text="RNAssistantBuildNumber must be an integer from 0 to 65534." />
    <Error Condition="$(RNAssistantBuildNumber) &gt; 65534" Text="RNAssistantBuildNumber must be an integer from 0 to 65534." />
    <Error Condition="'$(FileVersion)' != '$(RNAssistantVersionPrefix).$(RNAssistantBuildNumber)'" Text="FileVersion must use the product prefix and RNAssistantBuildNumber." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(FileVersion)', '^[0-9]{1,5}(\.[0-9]{1,5}){3}$')) or !$([System.Text.RegularExpressions.Regex]::IsMatch('$(AssemblyVersion)', '^[0-9]{1,5}(\.[0-9]{1,5}){3}$'))" Text="Numeric versions require four components from 0 to 65534." />
    <Error Condition="$([System.Version]::Parse('$(FileVersion)').Major) &gt; 65534 or $([System.Version]::Parse('$(FileVersion)').Minor) &gt; 65534 or $([System.Version]::Parse('$(FileVersion)').Build) &gt; 65534 or $([System.Version]::Parse('$(AssemblyVersion)').Major) &gt; 65534 or $([System.Version]::Parse('$(AssemblyVersion)').Minor) &gt; 65534 or $([System.Version]::Parse('$(AssemblyVersion)').Build) &gt; 65534 or $([System.Version]::Parse('$(AssemblyVersion)').Revision) &gt; 65534" Text="Numeric version components cannot exceed 65534." />
    <Error Condition="'$(InformationalVersion)' != '$(_RNAssistantExpectedInformationalVersion)'" Text="InformationalVersion must include the product version and commit identity." />
    <Error Condition="'$(ApplicationVersion)' != '$(FileVersion)'" Text="VSTO ApplicationVersion must match numeric FileVersion." />
    <Error Condition="'$(RNAssistantWorkingTreeState)' != 'clean' and '$(RNAssistantWorkingTreeState)' != 'dirty' and (Exists('$(_RNAssistantRepositoryRoot).git') or '$(RNAssistantWorkingTreeState)' != 'unknown')" Text="RNAssistantWorkingTreeState must be clean or dirty (unknown is allowed only for source archives)." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(RNAssistantBuildUtc)', '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$'))" Text="RNAssistantBuildUtc must be an explicit UTC timestamp (yyyy-MM-ddTHH:mm:ssZ)." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(RNAssistantBuildEvidenceSignerSha256)', '^(unavailable|[0-9a-f]{64})$'))" Text="RNAssistantBuildEvidenceSignerSha256 must be unavailable or a lowercase SHA-256 certificate fingerprint." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(RNAssistantRuntimePlatform)', '^[A-Za-z0-9 ._-]{1,32}$'))" Text="RNAssistantRuntimePlatform must be a bounded platform name." />
  </Target>

  <Target Name="GenerateRNAssistantVersionInfo"
          BeforeTargets="CoreCompile"
          DependsOnTargets="ValidateVersionFormat"
          Condition="'$(MSBuildProjectExtension)' == '.csproj' and '$(UsingMicrosoftNETSdk)' != 'true'">
    <ItemGroup>
      <_RNAssistantAssemblyAttribute Include="System.Reflection.AssemblyVersionAttribute">
        <_Parameter1>$(AssemblyVersion)</_Parameter1>
      </_RNAssistantAssemblyAttribute>
      <_RNAssistantAssemblyAttribute Include="System.Reflection.AssemblyFileVersionAttribute">
        <_Parameter1>$(FileVersion)</_Parameter1>
      </_RNAssistantAssemblyAttribute>
      <_RNAssistantAssemblyAttribute Include="System.Reflection.AssemblyInformationalVersionAttribute">
        <_Parameter1>$(InformationalVersion)</_Parameter1>
      </_RNAssistantAssemblyAttribute>
      <_RNAssistantAssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>%(AssemblyMetadata.Identity)</_Parameter1>
        <_Parameter2>%(AssemblyMetadata.Value)</_Parameter2>
      </_RNAssistantAssemblyAttribute>
    </ItemGroup>
    <WriteCodeFragment
      Language="C#"
      OutputFile="$(IntermediateOutputPath)RNAssistant.Version.g.cs"
      AssemblyAttributes="@(_RNAssistantAssemblyAttribute)">
      <Output TaskParameter="OutputFile" ItemName="Compile" />
    </WriteCodeFragment>
  </Target>

  <Import Project="$(MSBuildThisFileDirectory)build/RNAssistant.Release.targets" />
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'RNAssistant.Desktop' or '$(MSBuildProjectName)' == 'RNAssistant.ExcelAddIn' or '$(MSBuildProjectName)' == 'RNAssistant.WordAddIn' or '$(MSBuildProjectName)' == 'RNAssistant.PowerPointAddIn' or '$(MSBuildProjectName)' == 'RNAssistant.OutlookAddIn'">
    <Content Include="$(MSBuildThisFileDirectory)src/RNAssistant.JsWorker/bin/$(Configuration)/RNAssistant.JsWorker.exe;$(MSBuildThisFileDirectory)src/RNAssistant.JsWorker/bin/$(Configuration)/RNAssistant.JsWorker.exe.config;$(MSBuildThisFileDirectory)src/RNAssistant.JsWorker/bin/$(Configuration)/Jint.dll;$(MSBuildThisFileDirectory)src/RNAssistant.JsWorker/bin/$(Configuration)/Acornima.dll">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(MSBuildThisFileDirectory)packages/Microsoft.Data.Sqlite.Core.10.0.10/lib/netstandard2.0/Microsoft.Data.Sqlite.dll;$(MSBuildThisFileDirectory)packages/SQLitePCLRaw.core.2.1.11/lib/netstandard2.0/SQLitePCLRaw.core.dll;$(MSBuildThisFileDirectory)packages/SQLitePCLRaw.provider.winsqlite3.2.1.11/lib/netstandard2.0/SQLitePCLRaw.provider.winsqlite3.dll;$(MSBuildThisFileDirectory)packages/SQLitePCLRaw.provider.sqlite3.2.1.11/lib/netstandard2.0/SQLitePCLRaw.provider.sqlite3.dll;$(MSBuildThisFileDirectory)packages/Microsoft.Bcl.HashCode.6.0.0/lib/net462/Microsoft.Bcl.HashCode.dll;$(MSBuildThisFileDirectory)packages/System.Buffers.4.6.1/lib/net462/System.Buffers.dll;$(MSBuildThisFileDirectory)packages/System.Memory.4.6.3/lib/net462/System.Memory.dll;$(MSBuildThisFileDirectory)packages/System.Numerics.Vectors.4.6.1/lib/net462/System.Numerics.Vectors.dll;$(MSBuildThisFileDirectory)packages/System.Runtime.CompilerServices.Unsafe.6.1.2/lib/net462/System.Runtime.CompilerServices.Unsafe.dll">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(MSBuildThisFileDirectory)packages/Microsoft.Web.WebView2.1.0.2903.40/lib/net462/Microsoft.Web.WebView2.Core.dll;$(MSBuildThisFileDirectory)packages/Microsoft.Web.WebView2.1.0.2903.40/lib/net462/Microsoft.Web.WebView2.WinForms.dll;$(MSBuildThisFileDirectory)packages/Newtonsoft.Json.13.0.3/lib/net45/Newtonsoft.Json.dll;$(MSBuildThisFileDirectory)packages/PdfPig.0.1.15/lib/net471/UglyToad.PdfPig.dll;$(MSBuildThisFileDirectory)packages/PdfPig.0.1.15/lib/net471/UglyToad.PdfPig.Core.dll;$(MSBuildThisFileDirectory)packages/PdfPig.0.1.15/lib/net471/UglyToad.PdfPig.DocumentLayoutAnalysis.dll;$(MSBuildThisFileDirectory)packages/PdfPig.0.1.15/lib/net471/UglyToad.PdfPig.Fonts.dll;$(MSBuildThisFileDirectory)packages/PdfPig.0.1.15/lib/net471/UglyToad.PdfPig.Tokenization.dll;$(MSBuildThisFileDirectory)packages/PdfPig.0.1.15/lib/net471/UglyToad.PdfPig.Tokens.dll;$(MSBuildThisFileDirectory)vendor/pdf-rendering/managed/PDFtoImage.dll;$(MSBuildThisFileDirectory)vendor/pdf-rendering/managed/SkiaSharp.dll">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(MSBuildThisFileDirectory)packages/Microsoft.Web.WebView2.1.0.2903.40/build/native/x64/WebView2Loader.dll"><Link>x64\WebView2Loader.dll</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="$(MSBuildThisFileDirectory)packages/Microsoft.Web.WebView2.1.0.2903.40/build/native/x86/WebView2Loader.dll"><Link>x86\WebView2Loader.dll</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="$(MSBuildThisFileDirectory)vendor/pdf-rendering/runtimes/win-x64/native/pdfium.dll"><Link>x64\pdfium.dll</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="$(MSBuildThisFileDirectory)vendor/pdf-rendering/runtimes/win-x64/native/libSkiaSharp.dll"><Link>x64\libSkiaSharp.dll</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="$(MSBuildThisFileDirectory)vendor/pdf-rendering/runtimes/win-x86/native/pdfium.dll"><Link>x86\pdfium.dll</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="$(MSBuildThisFileDirectory)vendor/pdf-rendering/runtimes/win-x86/native/libSkiaSharp.dll"><Link>x86\libSkiaSharp.dll</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
  </ItemGroup>
  <Target Name="BuildRNAssistantJsWorker" BeforeTargets="Build"
          Condition="'$(MSBuildProjectName)' == 'RNAssistant.Office'">
    <MSBuild Projects="$(MSBuildThisFileDirectory)src/RNAssistant.JsWorker/RNAssistant.JsWorker.csproj"
             Targets="Build" Properties="Configuration=$(Configuration);Platform=AnyCPU" />
  </Target>
  <Target Name="CopyRNAssistantJsWorker" AfterTargets="Build"
          Condition="'$(MSBuildProjectName)' == 'RNAssistant.Office' or '$(MSBuildProjectName)' == 'RNAssistant.Desktop' or '$(MSBuildProjectName)' == 'RNAssistant.ExcelAddIn' or '$(MSBuildProjectName)' == 'RNAssistant.WordAddIn' or '$(MSBuildProjectName)' == 'RNAssistant.PowerPointAddIn' or '$(MSBuildProjectName)' == 'RNAssistant.OutlookAddIn'">
    <ItemGroup>
      <RNAssistantJsWorkerFile Include="$(MSBuildThisFileDirectory)src/RNAssistant.JsWorker/bin/$(Configuration)/RNAssistant.JsWorker.exe" />
      <RNAssistantJsWorkerFile Include="$(MSBuildThisFileDirectory)src/RNAssistant.JsWorker/bin/$(Configuration)/RNAssistant.JsWorker.exe.config" />
      <RNAssistantJsWorkerFile Include="$(MSBuildThisFileDirectory)src/RNAssistant.JsWorker/bin/$(Configuration)/Jint.dll" />
      <RNAssistantJsWorkerFile Include="$(MSBuildThisFileDirectory)src/RNAssistant.JsWorker/bin/$(Configuration)/Acornima.dll" />
      <RNAssistantJsWorkerFile Include="$(MSBuildThisFileDirectory)src/RNAssistant.JsWorker/bin/$(Configuration)/Newtonsoft.Json.dll" />
      <RNAssistantJsWorkerFile Include="$(MSBuildThisFileDirectory)src/RNAssistant.JsWorker/bin/$(Configuration)/System.Memory.dll" />
      <RNAssistantJsWorkerFile Include="$(MSBuildThisFileDirectory)src/RNAssistant.JsWorker/bin/$(Configuration)/System.Buffers.dll" />
      <RNAssistantJsWorkerFile Include="$(MSBuildThisFileDirectory)src/RNAssistant.JsWorker/bin/$(Configuration)/System.Runtime.CompilerServices.Unsafe.dll" />
    </ItemGroup>
    <Error Condition="!Exists('%(RNAssistantJsWorkerFile.Identity)')"
           Text="Required JavaScript worker deployment file is missing: %(RNAssistantJsWorkerFile.Identity)" />
    <Copy SourceFiles="@(RNAssistantJsWorkerFile)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyRNAssistantSqlite" AfterTargets="CopyRNAssistantJsWorker"
          Condition="'$(MSBuildProjectName)' == 'RNAssistant.Office' or '$(MSBuildProjectName)' == 'RNAssistant.Desktop' or '$(MSBuildProjectName)' == 'RNAssistant.ExcelAddIn' or '$(MSBuildProjectName)' == 'RNAssistant.WordAddIn' or '$(MSBuildProjectName)' == 'RNAssistant.PowerPointAddIn' or '$(MSBuildProjectName)' == 'RNAssistant.OutlookAddIn'">
    <ItemGroup>
      <RNAssistantSqliteFile Include="$(MSBuildThisFileDirectory)packages/Microsoft.Data.Sqlite.Core.10.0.10/lib/netstandard2.0/Microsoft.Data.Sqlite.dll" />
      <RNAssistantSqliteFile Include="$(MSBuildThisFileDirectory)packages/SQLitePCLRaw.core.2.1.11/lib/netstandard2.0/SQLitePCLRaw.core.dll" />
      <RNAssistantSqliteFile Include="$(MSBuildThisFileDirectory)packages/SQLitePCLRaw.provider.winsqlite3.2.1.11/lib/netstandard2.0/SQLitePCLRaw.provider.winsqlite3.dll" />
      <RNAssistantSqliteFile Include="$(MSBuildThisFileDirectory)packages/SQLitePCLRaw.provider.sqlite3.2.1.11/lib/netstandard2.0/SQLitePCLRaw.provider.sqlite3.dll" />
      <RNAssistantSqliteFile Include="$(MSBuildThisFileDirectory)packages/Microsoft.Bcl.HashCode.6.0.0/lib/net462/Microsoft.Bcl.HashCode.dll" />
      <RNAssistantSqliteFile Include="$(MSBuildThisFileDirectory)packages/System.Buffers.4.6.1/lib/net462/System.Buffers.dll" />
      <RNAssistantSqliteFile Include="$(MSBuildThisFileDirectory)packages/System.Memory.4.6.3/lib/net462/System.Memory.dll" />
      <RNAssistantSqliteFile Include="$(MSBuildThisFileDirectory)packages/System.Numerics.Vectors.4.6.1/lib/net462/System.Numerics.Vectors.dll" />
      <RNAssistantSqliteFile Include="$(MSBuildThisFileDirectory)packages/System.Runtime.CompilerServices.Unsafe.6.1.2/lib/net462/System.Runtime.CompilerServices.Unsafe.dll" />
    </ItemGroup>
    <Error Condition="!Exists('%(RNAssistantSqliteFile.Identity)')"
           Text="Required SQLite deployment file is missing: %(RNAssistantSqliteFile.Identity)" />
    <Copy SourceFiles="@(RNAssistantSqliteFile)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyRNAssistantManagedClosure" AfterTargets="CopyRNAssistantSqlite"
          Condition="'$(MSBuildProjectName)' == 'RNAssistant.Desktop' or '$(MSBuildProjectName)' == 'RNAssistant.ExcelAddIn' or '$(MSBuildProjectName)' == 'RNAssistant.WordAddIn' or '$(MSBuildProjectName)' == 'RNAssistant.PowerPointAddIn' or '$(MSBuildProjectName)' == 'RNAssistant.OutlookAddIn'">
    <ItemGroup>
      <RNAssistantManagedFile Include="$(MSBuildThisFileDirectory)packages/Microsoft.Web.WebView2.1.0.2903.40/lib/net462/Microsoft.Web.WebView2.Core.dll" />
      <RNAssistantManagedFile Include="$(MSBuildThisFileDirectory)packages/Microsoft.Web.WebView2.1.0.2903.40/lib/net462/Microsoft.Web.WebView2.WinForms.dll" />
      <RNAssistantManagedFile Include="$(MSBuildThisFileDirectory)packages/Newtonsoft.Json.13.0.3/lib/net45/Newtonsoft.Json.dll" />
      <RNAssistantManagedFile Include="$(MSBuildThisFileDirectory)packages/PdfPig.0.1.15/lib/net471/UglyToad.PdfPig.dll" />
      <RNAssistantManagedFile Include="$(MSBuildThisFileDirectory)packages/PdfPig.0.1.15/lib/net471/UglyToad.PdfPig.Core.dll" />
      <RNAssistantManagedFile Include="$(MSBuildThisFileDirectory)packages/PdfPig.0.1.15/lib/net471/UglyToad.PdfPig.DocumentLayoutAnalysis.dll" />
      <RNAssistantManagedFile Include="$(MSBuildThisFileDirectory)packages/PdfPig.0.1.15/lib/net471/UglyToad.PdfPig.Fonts.dll" />
      <RNAssistantManagedFile Include="$(MSBuildThisFileDirectory)packages/PdfPig.0.1.15/lib/net471/UglyToad.PdfPig.Tokenization.dll" />
      <RNAssistantManagedFile Include="$(MSBuildThisFileDirectory)packages/PdfPig.0.1.15/lib/net471/UglyToad.PdfPig.Tokens.dll" />
      <RNAssistantManagedFile Include="$(MSBuildThisFileDirectory)vendor/pdf-rendering/managed/PDFtoImage.dll" />
      <RNAssistantManagedFile Include="$(MSBuildThisFileDirectory)vendor/pdf-rendering/managed/SkiaSharp.dll" />
    </ItemGroup>
    <Error Condition="!Exists('%(RNAssistantManagedFile.Identity)')"
           Text="Required offline deployment file is missing: %(RNAssistantManagedFile.Identity)" />
    <Copy SourceFiles="@(RNAssistantManagedFile)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyRNAssistantNativeClosure" AfterTargets="CopyRNAssistantManagedClosure"
          Condition="'$(MSBuildProjectName)' == 'RNAssistant.Desktop' or '$(MSBuildProjectName)' == 'RNAssistant.ExcelAddIn' or '$(MSBuildProjectName)' == 'RNAssistant.WordAddIn' or '$(MSBuildProjectName)' == 'RNAssistant.PowerPointAddIn' or '$(MSBuildProjectName)' == 'RNAssistant.OutlookAddIn'">
    <ItemGroup>
      <RNAssistantNativeFile Include="$(MSBuildThisFileDirectory)packages/Microsoft.Web.WebView2.1.0.2903.40/build/native/x64/WebView2Loader.dll"><TargetPath>x64/WebView2Loader.dll</TargetPath></RNAssistantNativeFile>
      <RNAssistantNativeFile Include="$(MSBuildThisFileDirectory)packages/Microsoft.Web.WebView2.1.0.2903.40/build/native/x86/WebView2Loader.dll"><TargetPath>x86/WebView2Loader.dll</TargetPath></RNAssistantNativeFile>
      <RNAssistantNativeFile Include="$(MSBuildThisFileDirectory)vendor/pdf-rendering/runtimes/win-x64/native/pdfium.dll"><TargetPath>x64/pdfium.dll</TargetPath></RNAssistantNativeFile>
      <RNAssistantNativeFile Include="$(MSBuildThisFileDirectory)vendor/pdf-rendering/runtimes/win-x64/native/libSkiaSharp.dll"><TargetPath>x64/libSkiaSharp.dll</TargetPath></RNAssistantNativeFile>
      <RNAssistantNativeFile Include="$(MSBuildThisFileDirectory)vendor/pdf-rendering/runtimes/win-x86/native/pdfium.dll"><TargetPath>x86/pdfium.dll</TargetPath></RNAssistantNativeFile>
      <RNAssistantNativeFile Include="$(MSBuildThisFileDirectory)vendor/pdf-rendering/runtimes/win-x86/native/libSkiaSharp.dll"><TargetPath>x86/libSkiaSharp.dll</TargetPath></RNAssistantNativeFile>
    </ItemGroup>
    <Error Condition="!Exists('%(RNAssistantNativeFile.Identity)')"
           Text="Required offline native file is missing: %(RNAssistantNativeFile.Identity)" />
    <MakeDir Directories="$(TargetDir)x64;$(TargetDir)x86" />
    <Copy SourceFiles="@(RNAssistantNativeFile)"
          DestinationFiles="@(RNAssistantNativeFile->'$(TargetDir)%(TargetPath)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>

    </Reference>
    <Reference Include="UglyToad.PdfPig.Tokens">
      <HintPath>..\..\packages\PdfPig.0.1.15\lib\net8.0\UglyToad.PdfPig.Tokens.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\RNAssistant.Testing\FakeOfficeAdapter.cs" Link="FakeOfficeAdapter.cs" />
    <Compile Include="..\..\src\RNAssistant.Core\Models\*.cs" Link="Core\Models\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\RNAssistant.Core\Llm\*.cs" Link="Core\Llm\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\RNAssistant.Core\Tools\*.cs" Link="Core\Tools\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\RNAssistant.Core\Skills\*.cs" Link="Core\Skills\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\RNAssistant.Core\Services\*.cs" Link="Core\Services\%(Filename)%(Extension)" />
    <Compile
      Include="..\..\src\RNAssistant.Core\Storage\*.cs"
      Exclude="..\..\src\RNAssistant.Core\Storage\ProtectedSecretStore.cs;..\..\src\RNAssistant.Core\Storage\SettingsService.cs"
      Link="Core\Storage\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\RNAssistant.Office\Contracts\*.cs" Link="Office\Contracts\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\RNAssistant.Office\Agent\*.cs" Link="Office\Agent\%(Filename)%(Extension)" />

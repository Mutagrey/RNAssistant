<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\..\packages\Newtonsoft.Json.13.0.3\lib\net6.0\Newtonsoft.Json.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UglyToad.PdfPig">
      <HintPath>..\..\packages\PdfPig.0.1.15\lib\net8.0\UglyToad.PdfPig.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UglyToad.PdfPig.Core">
      <HintPath>..\..\packages\PdfPig.0.1.15\lib\net8.0\UglyToad.PdfPig.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UglyToad.PdfPig.DocumentLayoutAnalysis">
      <HintPath>..\..\packages\PdfPig.0.1.15\lib\net8.0\UglyToad.PdfPig.DocumentLayoutAnalysis.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UglyToad.PdfPig.Fonts">
      <HintPath>..\..\packages\PdfPig.0.1.15\lib\net8.0\UglyToad.PdfPig.Fonts.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UglyToad.PdfPig.Tokenization">
      <HintPath>..\..\packages\PdfPig.0.1.15\lib\net8.0\UglyToad.PdfPig.Tokenization.dll</HintPath>

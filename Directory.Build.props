<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- Single source of truth for the RNAssistant product version. -->
    <RNAssistantVersionPrefix>16.1.0</RNAssistantVersionPrefix>
    <RNAssistantVersionSuffix>dev</RNAssistantVersionSuffix>
    <!-- Preserve baseline assembly binding until Windows/VSTO qualification. -->
    <RNAssistantAssemblyVersion>16.0.4.0</RNAssistantAssemblyVersion>
    <RNAssistantBuildNumber Condition="'$(RNAssistantBuildNumber)' == ''">0</RNAssistantBuildNumber>
    <!-- Candidate builds pin the SHA-256 of the detached evidence signing certificate. -->
    <RNAssistantBuildEvidenceSignerSha256 Condition="'$(RNAssistantBuildEvidenceSignerSha256)' == ''">unavailable</RNAssistantBuildEvidenceSignerSha256>

    <VersionPrefix>$(RNAssistantVersionPrefix)</VersionPrefix>
    <VersionSuffix>$(RNAssistantVersionSuffix)</VersionSuffix>
    <Version Condition="'$(RNAssistantVersionSuffix)' == ''">$(RNAssistantVersionPrefix)</Version>
    <Version Condition="'$(RNAssistantVersionSuffix)' != ''">$(RNAssistantVersionPrefix)-$(RNAssistantVersionSuffix)</Version>
    <AssemblyVersion>$(RNAssistantAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(RNAssistantVersionPrefix).$(RNAssistantBuildNumber)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <ApplicationVersion>$(FileVersion)</ApplicationVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
